--- !u!114 &114900271049623953
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1709867586078768}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3f96b1d166d19b209697e35b35d65c76, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\nA GAME BY TRIBAND\r\n<size=9><color=#ffffffbb>discord.gg/triband  or  @tribandtweets</color></size>\r\n\r\n<color=#ffffffbb>Creative Direction</color>\r\n<b>TIM GARBOS & PETER BRUUN</b>\r\n\r\n<color=#ffffffbb>Lead Game Design</color>\r\n<b>TIM GARBOS</b>\r\n\r\n<color=#ffffffbb>Executive Producers</color>\r\n<b>RUNE K. DREWSEN</b>\r\n<b>PETER BRUUN</b>\r\n<b>TIM GARBOS</b>\r\n\r\n<color=#ffffffbb>Gameplay Design</color>\r\n<b>LASSE ASTRUP</b>\r\n<b>FELIX NORDANÅKER</b>\r\n<b>ÓSCAR LOSADA SUÁREZ</b>\r\n\r\n<color=#ffffffbb>Puns</color>\r\n<b>RUNE K. DREWSEN</b>\r\n\r\n<color=#ffffffbb>Audio Design</color>\r\n<b>MORTEN SKOUBOE</b>\r\n\r\n<color=#ffffffbb>Art Direction</color>\r\n<b>SIMON POST</b>\r\n\r\n<color=#ffffffbb>Programming</color>\r\n<b>LASSE ASTRUP</b>\r\n<b>PETER BRUUN</b>\r\n<b>TIM GARBOS</b>\r\n\r\n<color=#ffffffbb>Composer</color>\r\n<b>SUNE \"KØTER\" KØLSTER</b>\r\n\r\n<color=#ffffffbb>Animation</color>\r\n<b>FELIX NORDANÅKER</b>\r\n<b>LAURA ANDERSEN</b>\r\n\r\n<color=#ffffffbb>Challenge Design</color>\r\n<b>KAYODE SHONIBARE-LEWIS</b>\r\n<b>MORTEN SKOUBOE</b>\r\n<b>ASGER STRANDBY</b>\r\n<b>LASSE ASTRUP</b>\r\n\r\n<color=#ffffffbb>2D Art</color>\r\n<b>SIMON POST</b>\r\n<b>FELIX NORDANÅKER</b>\r\n<b>RUNE K. DREWSEN</b>\r\n\r\n<color=#ffffffbb>3D Art</color>\r\n<b>LAURA ANDERSEN</b>\r\n<b>ANDREAS JÖRGENSEN</b>\r\n<b>PETER BRUUN</b>\r\n<b>BASTIAN LEONHARDT STRUBE</b>\r\n\r\n<color=#ffffffbb>Additional Programming</color>\r\n<b>MARTIN DOHNAL</b>\r\n<b>CASPER FRIIS FARSØE</b>\r\n<b>JENS-KRISTIAN NIELSEN</b>\r\n<b>JESPER RASMUSSEN</b>\r\n\r\n<color=#ffffffbb>Gameplay Consulting</color>\r\n<b>THOMAS LØFGREN</b>\r\n<b>MARTIN FASTERHOLDT</b>\r\n<b>MARTIN PICHLMAIR</b>\r\n\r\n<color=#ffffffbb>Audio Consulting</color>\r\n<b>MARTIN KVALE</b>\r\n\r\n<color=#ffffffbb>Marketing</color>\r\n<b>RUNE K. DREWSEN</b>\r\n<b>AMANDA JAMES</b>\r\n\r\n<color=#ffffffbb>Legal</color>\r\n<b>ROBERT JØNSSON</b>\r\n\r\n<color=#ffffffbb>Gameplay Interns</color>\r\n<b>LIVA STUBBE</b>\r\n<b>JONAS Ø. HAUGESEN</b>\r\n<b>LUKAS NØRGÅRD</b>\r\n<b>ALEXANDER NYBRO BJERKING</b>\r\n\r\n<color=#ffffffbb>Special thanks to</color>\r\n<b>KELD REINICKE</b>\r\n<b>ALLAN RASMUSSEN</b>\r\n\r\n\r\n<color=#ffffffbb>Produced by Apple.</color>\r\n<color=#ffffffbb>Published by THE LABEL</color>\r\n\r\n<color=#ffffffbb>Mobile publishing</color>\r\n<b>THE LABEL</b>\r\n<size=9>MIKE OUYE\r\nEDDIE HSU\r\nJOSH BABICH</size>\r\n\r\n<color=#ffffffbb>Funded in part by</color>\r\n<b>FoxNext Games</b>\r\n<size=9>TQ JEFFERSON\r\nVP External Development\r\nSYLVIA SON\r\nVP Marketing\r\nDEVIN RADFORD\r\nVP Business Development\r\nDAVID LOGAN\r\nExecutive Producer, Indie Initiative\r\nJARED YEAGER\r\nExecutive Producer\r\nJEREMY HIBNICK\r\nProducer\r\nWILL HUMMEL\r\nDirector of Business Development\r\nNATASHA SOSTROM\r\nMarketing Coordinator\r\n<color=#ffffffbb>© 2019 Twentieth Century Fox Film Corporation</color></size>\r\n\r\n<color=#ffffffbb>Apple TV and Mac Porting assistance</color>\r\n<b>KITTEHFACE SOFTWARE</b>\r\n<size=9>JEREMY STATZ\r\nJOEL BURKE\r\nJULIEN MURTIN\r\nJARED BIALO\r\nBILL ROESKE</size>\r\n\r\n<color=#ffffffbb>Marketing and Publishing support</color>\r\n<b>POPAGENDA</b>\r\n<size=9>GENEVIEVE ST-ONGE\r\nNICOLAS BERTRAND-VERGE\r\nMARIE-CHRISTINE BOURDUA\r\nBELINDA GARCIA</size>\r\n\r\n<color=#ffffffbb>Crowd Publishing</color>\r\n<b>FIG TEAM</b>\r\n<size=9>JUSTIN BAILEY\r\nREECE DENZEL\r\nEASTON GORISHEK\r\nASH LEAVENWORTH\r\nJON PAGE\r\nJONATHAN CHAN\r\nRYAN DELANEY\r\nANDREW HO\r\nMATT FINI</size>\r\n\r\n<b>BACKERS</b>\r\n<size=8>PHILL SENCH, TARO TAKEDA, YASUO TUBE, ASTRID REFSTRUP, LAU KORSGAARD, JEAN BLANCHARD, ETHAN BRUINS, ANDERS DALGAARD, JACOB HEROLD, JANNEK KRISTENSEN, TOBIAS LIENHARD, GEORGE REED, CARL PERSSON, ANETTE STALOY, MIKAEL FRIBERG, JUSTIN BAILEY, DALJIT CHANDI, BARRIE TINGLE, CHRIS FILIP, MATTHEW GARTZKE, DREW HIMMELREICH, CHRISTINA GRAY, KYLE WOOLNER, TONY MULHERN, CHRIS JOHNSON, BOB IPPOLITO, KERI BAILEY, DAVID HUNTER, TAYLOR MORRIS, ALEX SCHWARTZ, KEVIN SLACKIE, EDWARD MELCER, STEVEN FERRARINI, JESSE SOFIE, CHARLIE SPEIGHT, PETER BRODERSEN, ADAM BURTON, SEAN O'CONNELL, DEVIN GILLELAND, TYLER GERMANN, DANIEL MURPHY, BRYAN HINZE, JOSHUA GUZIER, MATTHEW CARLSON, JAMES LAMBERT, DEREK OUTWATER, ARTURO FLORES-VARGAS, GRAYSON ADLER, JESSE ROBERGE, JAKOB HANSSON, BOB HORN, ERIC HERVOL, KATRINA EATON, CHRISTOPHER CERNIGLIA, THOMAS BAZZLE, CHRIS DINI, T. A., CHARLES HERMAN, ANDREW ANDERSON, MAXIME TURMEL, COLIN MACLAUGHLIN, HIROYUKI SASAKI, GRZEGORZ PRUSINOWSKI, GREYSON DITZLER, NOAH STRAHAN, ANTONY BEARPARK, ALESSANDRO SALVATI, RYAN KABIR, LUKE GATER, LUKAS DANIEL KLAUSNER, HEATHER WILLIS, MATTHEW CARR, SIGNOUT.DK, PETER GOODWIN, MICHAEL VOLLMER, DAVID FREDERICKS, HARRISON FRY, WILLIAM FRENCH, BREON PRESTBURY, MATT HUDGINS, JAE HUN SHIN, RICK BAILEY, ELLIOT HUBER, DENZEL PERSAUD, ANISTER, KOENRAAD GOSSAERT, OLIVER SIMPSON, DAVID GASTON, STEVEN BASART, NICHOLAS BROWDER, JASON JIVIDEN, SCOTT MUNRO, JACKSON WALTERS, ANDREW CALABRESE, EMIL BENGTSSON, TRISTAN KENNEDY, OLE HELLAND, RACHEL FRANKLAND, TRAVIS GAGNON, EDGAR GONZALEZ, CHARLES LUKE, ETHAN WRIGHT, STEPHEN CRONK, MATT MCCOY, JAMES CLEVERDON, A. CLEVERDON, VICTOR WRIGHT, ISABEL SÖDERLIND, JOSHUA GRADY, GARTH FRANTZEN, MATTHEW ANDRYSIAK, MAXWELL BECCHIO, BRENT URMEY, ROBIN NEAL, MURPHY THE POTATO, IAN FRANKLIN, AMOGH BIJUR, TRISTAN WOJCIECHOWSKI, CASEY CONNOR, LEVI BENNETT, XABIER PÉREZ DEL VAL, KALLE RENNES, CARLOS CATALAN, DANIEL PATRICK, JILL HOFFMAN, INTERIM DESCRIPTOR, BLAKE MALOOF, STOJAN BRAJOVIC, AARON MORI, NICK LAMARRE, CLINTON HALLAHAN, RYAN HICKS, ADAM BEAL, JOHN ALVARADO, MICHAEL YUN, JERRY FLOWERS, TAIGA KITAGAWA, DAVID '-1' SCHMID, ELEONOR LAGERKRANTS, YAELLE MOITY, TILL KLEINERT, CHRIS MINNER, SAMUEL KACK, MATTHEW EVANS, ERIC YOUNG, ADAM MILLER, JOSH MATHEWS, SIMON HISCHIER, KEV FRENCH, HANS VON KNUT, MATT FOLEY, RICHARD LAZAR, JEPPE SØRENSEN, TOR LUBICH FRUERGAARD, NICK DECONTI, SIMON DROSCHER, JAMES WHITWELL, REMBRANDT HAFT, CRISTOFER HESS, DAVE MOORES, RYAN MCLEOD, VINCENT KOCKS, WILL BOURDILLON, SHAWN FASSBENDER, MARK BUSKBJERG, JESPER NØRREGAARD HENRIKSEN, ALMUT SCHWACKE, MISCHA SZPIRT, BO JØRGENSEN, DANNY GUNN, JONATHAN WALKER, REX CROWLE, STEVEN MONDELAERS, PAUL HARTE, KASPER VIDEBÆK, JOHN MACFADYEN, DAVE PEMBERTON, TOM WHITE, EDISON HE, DAVE DIXON, JAMES OSTLER, DANIEL CURIOTTO, ROSS WILLIAMS, JEREMY LANUM, JIMMY ASAY, DAN RODRIGUEZ, SAWYER DINGER, NEIMA MEHRROSTAMI, RAY CORNWALL, TRACE JOHNSON, MATTHEW MOORE, JAMES GREGORY, PATRICK SHAIN, KEVIN MCDONALD, LAURIE AITKEN, MARCIN JANIK, NATHANAEL MARQUARDT, FELIX LAU, MICHAEL DANYLCHUK, CHRIS GALLIZZI, RAFE S., BOB CASE, SÉBASTIEN DELAHAYE, SETH MADLON-KAY, JASON FRISVOLD, WLADISLAV HASSUN, JAN NEMECEK, TOILETPAPER GC, ROGER PERSSON, GREG S., JUSTIN WOODWARD, CHRISTIAN SCHOTT, BILL AYAKATUBBY, RICHARD GALE, RORY O'KELLY, JOSHUA CARMODY, DAVID REID, CHRISTIAN SCHUBERT, CARLOS LÓPEZ, MIKE MCCRINDLE, MATTHEW BORGELT, KAZUYA MIYUKI, PAT ENGLE, JAMES PARKER</size>\r\n<b>Thank you all so much! This game wouldn't be here without you!</b>\r\n\r\n<color=#ffffffbb>Thanks to</color>\r\n<color=#ffffffbb>THE DANISH FILM INSTITUTE</color>\r\n\r\n<color=#ffffffbb>Quality Assurance</color>\r\n<b>Napnok Games</b>\r\n<size=9>DAJANA DIMOVSKA\r\nFILIP GEORGIJEV\r\nTOMISLAV DIMITROVSKI\r\nBODAN MOJSILOVIKJ</size>\r\n\r\n<color=#ffffffbb>Additional QA</color>\r\n<b>Keywords Studios</b>\r\n\r\n<color=#ffffffbb>Discord Heroes</color>\r\n<size=9>FRISKYDOUGHNUTS\r\nBOO, THE TOASTER X5\r\nSWORDSLASH\r\nHYPE\r\nFRISKYDOUGHNUTS\r\nLOTBLIND\r\nGREG\r\n</size>\r\n<color=#ffffffbb>Playtesters</color>\r\n<size=8>CHARLENE PUTNEY, MARIA VICKI LINDBAUM, SØREN ARCTANDER MATTHIESSEN, FREDERIC PEDERSEN, KIKKO HENRIKSEN, THOMAS SIGGAARD ANDERSEN, RUNE SØNDERGAARD, CLAUS BENTOW, ELIAS BENTOW, EMIL BEIER, ARIELLAH ENGEL, KONRAD HERON, IVAN MALINOVSKI, PETER MARCANIK, ALEXANDER HARTFELT, PETER BUSK, YUK-KINNICOLAJ, MADS CHRISTIANSEN, IVAN MALINOVSKI,JULIANNA COSTA PEDRO DALCIN, RICHARD BAXTER, CAROLINE FANGEL, NICKLAS NYGREN, MIRA DORTHÉ, PERNILLE SIHM, ANCHEL LABENA, LAU KORSGAARD, JULIE HEYDE, ARNT JENSEN, JONATAN VON HOVE, HORATIU ROMAN, NIKLAS JØRGENSEN, WILLIAM REYNISH, WILHELM NYLUND</size>\r\n\r\n<color=#ffffffbb>Special thanks to</color>\r\n<size=9>EVERYONE AT EXILE\r\nVALLEKILDE\r\nNORDIC GAMEDEV SCENE\r\n\r\nTEAM SUPER HOT\r\nLANDFALL\r\nDOUBLEFINE\r\nCOFFEESTAIN\r\nDIE GUTE FABRIK\r\nTRIPLE TOPPING\r\n\r\nMALTE BURUP\r\nJESPER TAXBØL\r\nJEPPE CARLSEN\r\nJUSTIN SMITH\r\nROBERT BOWLING\r\nJOHN POLSON (for his patience)\r\nCHRISTINE THARUP\r\nSØREN KOKBØL\r\nJULIE HEYDE\r\nPATRICK JARNFELT\r\nHANNAH NICKLIN\r\nWILLIAM CHYR\r\nGORDON\r\nCHARLIE PAW\r\nCHARLIE SPEIGHT\r\n\r\nEXPERIMENTAL GAMEPLAY WORKSHOP\r\nINDEPENDENT GAMES FESTIVAL\r\nINDIECADE\r\nINDIE MEGABOOOTH\r\nINDIE ARENA BOOTH\r\n\r\n\r\nFAMILIES AND FRIENDS\r\n &\r\nALL THE PEOPLE AROUND US\r\n\r\n\r\n</size>\r\n<color=#ffffffbb>THANK YOU FOR PLAYING!</color>\r\n<color=#ffffffbb>WE HOPE YOU ENJOYED IT</color>\r\n\r\n<color=#ffffffff>WHATTHEGOLF.COM</color>\r\n\r\n\r\n\r\n\r\n\r\n<color=#ffffffbb>THANK YOU FOR SCROLLING ALL THE WAY DOWN HERE!</color>\r\n"
